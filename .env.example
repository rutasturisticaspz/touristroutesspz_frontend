# Copie este archivo como .env.local
#
# No hay valores por defecto que apunten a ningún servidor: si falta
# una variable, la aplicación lo dice en vez de conectarse a un lugar
# inesperado. El sitio viejo tenía quemado
# https://api.quehacerenperez.com/api como respaldo.

NEXT_PUBLIC_API_URL=http://localhost:2999/api

# Llave de Google Maps. Va a ser una llave institucional de la UNA.
# Si se deja vacía, los mapas muestran un aviso en vez de romperse.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
